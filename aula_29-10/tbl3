5-
const express = require('express');
const cors = require('cors');
const app = express();

app.use(cors({
    origin: 'http://localhost:5500',
    methods: ['GET']
}));

app.get('/usuarios', (req, res) => {
    res.json([{ id: 1, nome: 'Lucas' }]);
});

app.listen(3000, () => console.log('Servidor rodando na porta 3000'));

limitar os métodos aplica o princípio de menor privilégio, a api só libera pra essa origem as operações realmente necessárias, com methods: get, mesmo que existam rotas de post, put ou delete, o navegador só permite leitura, qualquer outra tentativa é barrada na fase de preflight, antes da requisição ser enviada.
obs: isso não é proteção absoluta, um cliente fora do navegador não é afetado pelo cors e por isso restringir operações sensíveis (criar, editar, apagar) também exige autorização no backend, não só cors.
